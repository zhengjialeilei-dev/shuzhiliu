POSTGRES_DB=mathflow
POSTGRES_USER=mathflow
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_PORT=5432

WEB_PORT=8080
API_PORT=3001
API_BASE_URL=https://your-domain-or-ip
CORS_ORIGINS=https://your-domain-or-ip
COOKIE_SECURE=true
TRUST_PROXY=true

ADMIN_PASSWORD=replace-with-strong-admin-password
JWT_SECRET=replace-with-long-random-secret

STORAGE_DRIVER=s3
PUBLIC_ASSET_BASE_URL=
S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
S3_REGION=ap-guangzhou
S3_BUCKET=your-bucket-name
S3_PUBLIC_BASE_URL=https://your-public-bucket-domain
S3_ACCESS_KEY_ID=your-secret-id
S3_SECRET_ACCESS_KEY=your-secret-key
S3_FORCE_PATH_STYLE=false

HTML_PROXY_ALLOWLIST=your-public-bucket-domain
MAX_UPLOAD_FILE_SIZE_MB=200
