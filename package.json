{
  "name": "mathflow-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @mathflow/api\" \"npm run dev -w @mathflow/web\"",
    "build": "npm run build -w @mathflow/web && npm run build -w @mathflow/api",
    "check": "npm run check -w @mathflow/web",
    "lint": "npm run lint -w @mathflow/web",
    "test": "npm run test:release && npm run test -w @mathflow/api && npm run test -w @mathflow/web",
    "test:release": "node --test scripts/web-release.test.mjs scripts/release-smoke.test.mjs",
    "test:revisions": "node --test --test-concurrency=1 scripts/resource-revisions.test.mjs scripts/catalog-postgres.test.mjs scripts/catalog-api-postgres.test.mjs",
    "test:db": "node scripts/test-database.mjs",
    "test:db:wsl": "wsl -d Ubuntu -- bash scripts/test-database-wsl.sh",
    "teaching:list": "node scripts/teaching-projects.mjs --list",
    "teaching:check": "node scripts/teaching-projects.mjs --check",
    "teaching:build": "node scripts/teaching-projects.mjs --build",
    "test:teaching": "vitest run --config scripts/teaching/vitest.config.ts",
    "test:all": "npm test && npm run test:teaching",
    "deploy:web": "python deploy/deploy_web_site.py",
    "deploy:web:skip-build": "python deploy/deploy_web_site.py --skip-build",
    "start:web": "npm run preview -w @mathflow/web",
    "start:api": "npm run start -w @mathflow/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
